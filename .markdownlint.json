{
  "extends": "markdownlint/style/prettier",
  "rules": {
    "MD003": {
      "style": "consistent"
    },
    "MD004": {
      "style": "consistent"
    },
    "MD013": {
      "line_length": 120,
      "heading_line_length": 120,
      "code_block_line_length": 120,
      "code_blocks": true,
      "tables": false,
      "headers": true
    },
    "MD024": {
      "siblings_only": true
    },
    "MD033": false,
    "MD040": false,
    "MD041": false
  }
}
