# EditorConfig helps maintain consistent coding styles for multiple developers
# working on the same project across various editors and IDEs.
# editorconfig.org

root = true

# All files
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = 120

# YAML files
[*.{yml,yaml}]
indent_size = 2
indent_style = space

# JSON files
[*.json]
indent_size = 2
indent_style = space

# Shell scripts
[*.sh]
indent_size = 2
indent_style = space
end_of_line = lf

# Agent/prompt files
[*.agent.md]
max_line_length = 120
indent_size = 2
indent_style = space
# Code files
[*.{js,ts,tsx,jsx}]
indent_size = 2
indent_style = space

# Makefile
[Makefile]
indent_style = tab
